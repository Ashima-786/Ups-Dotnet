using System;
public class A1 { 
    public void checkPrimefn() { 
        Console.WriteLine("Enter a No:");
        int num =Convert.ToInt32(Console.ReadLine()); 
        int count = 0;
        for (int i = 1; i <= num; i++) {
            if (num % i == 0) {
                count++;
            }
        }
        if (count == 2) {
            Console.WriteLine(num + " is prime"); 
        } else {
            Console.WriteLine(num + " is not prime");
        }
    } 
} 
public class A2 { 
    public static void Main(string[] args) {
        A1 obj = new A1(); 
        obj.checkPrime(); 
    } 
}
